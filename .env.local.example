# Local-only secrets for dsh / acceptance runs.
# Copy to `.env.local`, fill values, chmod 600.
# NEVER commit `.env.local`. NEVER echo keys. NEVER paste into chat/logs/STATUS/commits.
# Gitignored via `.env*` in .gitignore.

# Compaction summarizer (Akqui / whatever your profile uses) — optional if unused
# export COMPACT_API_KEY="…"

# dsh/pi-ai client stub toward :8080 — MUST NOT be named LLAMA_API_KEY
# (llama-server maps LLAMA_API_KEY → --api-key). Reddit/community stub:
export LLAMACPP_API_KEY=local
